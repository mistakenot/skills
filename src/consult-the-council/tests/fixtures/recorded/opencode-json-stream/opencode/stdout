{"type":"tool_use","timestamp":1789032468806,"sessionID":"ses_f755b0823ffeqOHS10F8XEOvrV","part":{"type":"tool","tool":"read","callID":"call_ae206e1f5f3046f4bc1d1743","state":{"status":"completed","input":{"filePath":"/home/vscode/src/skills/src/planning-workflow/tests/test_agent_cli_contract.py"},"output":"<path>/home/vscode/src/skills/src/planning-workflow/tests/test_agent_cli_contract.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Validate the agent CLI flags our skills depend on against the installed CLIs.\n2: \n3: Three layers, all driven by ``agent-cli-contract.toml``:\n4: \n5: 1. **Help contract** — ``<cmd> --help`` of the installed ``claude``, ``codex``,\n6:    ``grok`` and ``herdr`` must advertise every flag and enum value the\n7:    contract lists. Fast, no auth, no tokens. This is the drift detector: a\n8:    CLI release that renames ``--dangerously-skip-permissions`` fails here.\n9: 2. **Source contract** — every agent invocation in the skill sources uses only\n10:    contracted flags, and every contracted flag is used somewhere. This keeps\n11:    the contract and the skills from drifting apart in either direction.\n12: 3. **Live smoke** (opt-in, ``AGENT_CLI_LIVE=1``) — runs the canonical headless\n13:    unattended invocation for each agent and expects a PONG. Bills tokens.\n14: \n15: Run:  uv run pytest src/planning-workflow/tests/\n16:       AGENT_CLI_LIVE=1 uv run pytest src/planning-workflow/tests/ -k live\n17: \"\"\"\n18: \n19: from __future__ import annotations\n20: \n21: import os\n22: import shutil\n23: import subprocess\n24: import sys\n25: \n26: import pytest\n27: \n28: from agent_cli_contract import (\n29:     DEFAULT_SCAN_ROOTS,\n30:     REPO_ROOT,\n31:     SRC_ROOT,\n32:     Command,\n33:     installed_version,\n34:     load_contract,\n35:     parse_help,\n36:     run_help,\n37:     scan_sources,\n38:     version_tuple,\n39: )\n40: \n41: CONTRACT = load_contract()\n42: COMMANDS = CONTRACT.all_commands()\n43: AGENT_NAMES = list(CONTRACT.agents)\n44: \n45: \n46: def _cmd_id(c: Command) -> str:\n47:     return c.key.replace(\" \", \"_\")\n48: \n49: \n50: # --- fixtures ---------------------------------------------------------------\n51: \n52: \n53: @pytest.fixture(scope=\"module\")\n54: def help_surfaces():\n55:     \"\"\"``--help`` parsed once per contracted command path.\"\"\"\n56:     surfaces = {}\n57:     for cmd in COMMANDS:\n58:         if shutil.which(cmd.agent) is None:\n59:             continue\n60:         rc, text = run_help(cmd.argv)\n61:         surfaces[cmd.key] = (rc, parse_help(cmd.argv, text))\n62:     return surfaces\n63: \n64: \n65: @pytest.fixture(scope=\"module\")\n66: def invocations():\n67:     return [inv for inv in scan_sources(DEFAULT_SCAN_ROOTS) if inv.flags]\n68: \n69: \n70: # --- layer 0: the CLIs are installed and current ----------------------------\n71: \n72: \n73: @pytest.mark.parametrize(\"agent\", AGENT_NAMES)\n74: def test_cli_on_path(agent):\n75:     assert shutil.which(agent), (\n76:         f\"`{agent}` is not on PATH. The delegate/review skills shell out to it; \"\n77:         f\"install the latest release before trusting the skills.\"\n78:     )\n79: \n80: \n81: @pytest.mark.parametrize(\"agent\", AGENT_NAMES)\n82: def test_installed_version_not_older_than_verified(agent):\n83:     if shutil.which(agent) is None:\n84:         pytest.fail(f\"`{agent}` not on PATH\")\n85:     want = CONTRACT.agents[agent].verified_version\n86:     got = installed_version(agent)\n87:     assert got, f\"could not parse `{agent} --version` output\"\n88:     assert version_tuple(got) >= version_tuple(want), (\n89:         f\"installed {agent} {got} is older than the contract's verified {want}; \"\n90:         f\"a green run on an old build proves nothing — update the CLI\"\n91:     )\n92: \n93: \n94: # --- layer 1: --help advertises every contracted flag and value -------------\n95: \n96: \n97: @pytest.mark.parametrize(\"cmd\", COMMANDS, ids=_cmd_id)\n98: def test_help_runs(cmd, help_surfaces):\n99:     if cmd.key not in help_surfaces:\n100:         pytest.fail(f\"`{cmd.agent}` not on PATH\")\n101:     rc, surface = help_surfaces[cmd.key]\n102:     assert rc == 0, f\"`{cmd.key} --help` exited {rc}:\\n{surface.text[-800:]}\"\n103:     assert surface.flags, f\"`{cmd.key} --help` produced no parseable options:\\n{surface.text[:800]}\"\n104: \n105: \n106: @pytest.mark.parametrize(\"cmd\", COMMANDS, ids=_cmd_id)\n107: def test_help_exposes_contract_flags(cmd, help_surfaces):\n108:     if cmd.key not in help_surfaces:\n109:         pytest.fail(f\"`{cmd.agent}` not on PATH\")\n110:     _, surface = help_surfaces[cmd.key]\n111:     missing = sorted(cmd.flags - surface.flags)\n112:     assert not missing, (\n113:         f\"`{cmd.key}` no longer advertises {missing} in --help \"\n114:         f\"(installed {installed_version(cmd.agent)}). The skills pass these flags; \"\n115:         f\"update the refs under src/planning-workflow and the contract.\\n\"\n116:         f\"Advertised: {sorted(surface.flags)}\"\n117:     )\n118: \n119: \n120: def _value_cases():\n121:     for cmd in COMMANDS:\n122:         for flag, values in cmd.values.items():\n123:             yield pytest.param(cmd, flag, values, id=f\"{_cmd_id(cmd)}[{flag}]\")\n124: \n125: \n126: @pytest.mark.parametrize(\"cmd,flag,values\", list(_value_cases()))\n127: def test_help_exposes_contract_values(cmd, flag, values, help_surfaces):\n128:     if cmd.key not in help_surfaces:\n129:         pytest.fail(f\"`{cmd.agent}` not on PATH\")\n130:     _, surface = help_surfaces[cmd.key]\n131:     advertised = surface.values.get(flag)\n132:     assert advertised, (\n133:         f\"`{cmd.key} --help` lists no enum values for {flag} \"\n134:         f\"(expected at least {list(values)}); the help format may have changed\"\n135:     )\n136:     missing = [v for v in values if v not in advertised]\n137:     assert not missing, (\n138:         f\"`{cmd.key} {flag}` no longer accepts {missing}; advertised: {sorted(advertised)}\"\n139:     )\n140: \n141: \n142: # --- layer 2: skill sources and the contract agree --------------------------\n143: \n144: \n145: def test_sources_use_only_contract_flags(invocations):\n146:     \"\"\"A skill that starts passing an unverified flag must add it to the contract.\"\"\"\n147:     problems = []\n148:     for inv in invocations:\n149:         cmd = CONTRACT.command(inv.agent, inv.path)\n150:         known = cmd.flags if cmd else frozenset()\n151:         for fl in inv.flags:\n152:             if fl not in known:\n153:                 rel = inv.file.relative_to(REPO_ROOT)\n154:                 where = \"unknown command path\" if cmd is None else \"flag not in contract\"\n155:                 problems.append(f\"{rel}:{inv.line}  `{inv.key} {fl}`  ({where})\")\n156:     assert not problems, (\n157:         \"agent invocations use flags the contract has not verified:\\n  \"\n158:         + \"\\n  \".join(sorted(set(problems)))\n159:         + \"\\nAdd them to src/planning-workflow/tests/agent-cli-contract.toml \"\n160:         \"(and confirm --help advertises them).\"\n161:     )\n162: \n163: \n164: def test_contract_flags_are_used_somewhere(invocations):\n165:     \"\"\"The contract should describe the real dependency surface, not accrete.\"\"\"\n166:     used = {(inv.key, fl) for inv in invocations for fl in inv.flags}\n167:     used |= {(\"claude\", fl) for fl in _evals_build_argv_flags()}\n168:     unused = sorted(f\"{cmd.key} {fl}\" for cmd in COMMANDS for fl in cmd.flags if (cmd.key, fl) not in used)\n169:     assert not unused, (\n170:         \"contract lists flags no skill source uses (remove them, or the scanner \"\n171:         \"missed an invocation — run `python src/planning-workflow/tests/agent_cli_contract.py`):\\n  \"\n172:         + \"\\n  \".join(unused)\n173:     )\n174: \n175: \n176: def test_scanner_finds_the_known_invocations(invocations):\n177:     \"\"\"Guard the scanner itself: the core skill invocations must be visible to it.\"\"\"\n178:     keys = {(inv.key, fl) for inv in invocations for fl in inv.flags}\n179:     for expected in [\n180:         (\"claude\", \"--dangerously-skip-permissions\"),\n181:         (\"claude\", \"-p\"),\n182:         (\"codex\", \"--dangerously-bypass-approvals-and-sandbox\"),\n183:         (\"codex exec\", \"--sandbox\"),\n184:         (\"grok\", \"--always-approve\"),\n185:         (\"herdr agent start\", \"--kind\"),\n186:         (\"herdr worktree create\", \"--branch\"),\n187:     ]:\n188:         assert expected in keys, f\"scanner no longer sees {expected} in the skill sources\"\n189: \n190: \n191: # --- layer 2b: the evals harness's hardcoded argv ---------------------------\n192: \n193: \n194: def _evals_build_argv_flags() -> list[str]:\n195:     if str(SRC_ROOT) not in sys.path:\n196:         sys.path.insert(0, str(SRC_ROOT))\n197:     from evals.runners import build_argv  # noqa: WPS433 — repo module\n198: \n199:     argv = build_argv(\"prompt\", \"model\")\n200:     return [a for a in argv if a.startswith(\"-\")]\n201: \n202: \n203: def test_evals_build_argv_matches_contract():\n204:     claude = CONTRACT.command(\"claude\", ())\n205:     assert claude is not None\n206:     flags = _evals_build_argv_flags()\n207:     unknown = [f for f in flags if f not in claude.flags]\n208:     assert not unknown, f\"src/evals/runners.py build_argv uses uncontracted flags: {unknown}\"\n209: \n210:     if str(SRC_ROOT) not in sys.path:\n211:         sys.path.insert(0, str(SRC_ROOT))\n212:     from evals.runners import build_argv\n213: \n214:     argv = build_argv(\"prompt\", \"model\")\n215:     for flag in (\"--permission-mode\", \"--output-format\"):\n216:         value = argv[argv.index(flag) + 1]\n217:         assert value in claude.values[flag], f\"build_argv passes {flag} {value!r}, not in contract values\"\n218: \n219: \n220: # --- layer 3: live smoke (opt-in, bills tokens) -----------------------------\n221: \n222: LIVE = os.environ.get(\"AGENT_CLI_LIVE\") == \"1\"\n223: \n224: \n225: @pytest.mark.parametrize(\"agent\", [a for a in AGENT_NAMES if CONTRACT.agents[a].live_smoke])\n226: def test_live_headless_smoke(agent):\n227:     \"\"\"The canonical unattended invocation runs to completion under closed stdin.\"\"\"\n228:     if not LIVE:\n229:         pytest.skip(\"set AGENT_CLI_LIVE=1 to run live headless smoke tests (bills tokens)\")\n230:     spec = CONTRACT.agents[agent]\n231:     try:\n232:         proc = subprocess.run(\n233:             spec.live_smoke,\n234:             stdin=subprocess.DEVNULL,\n235:             capture_output=True,\n236:             text=True,\n237:             timeout=120,\n238:             cwd=REPO_ROOT,\n239:         )\n240:     except subprocess.TimeoutExpired as exc:\n241:         # TimeoutExpired carries raw bytes even in text mode.\n242:         out = \"\".join(\n243:             part.decode(errors=\"replace\") if isinstance(part, bytes) else (part or \"\")\n244:             for part in (exc.stdout, exc.stderr)\n245:         )\n246:         if _looks_like_auth_prompt(out):\n247:             pytest.fail(\n248:                 f\"`{agent}` is not authenticated: headless mode fell into an interactive \"\n249:                 f\"login and hung. Run `{agent} login` and retry.\\n{out[-800:]}\"\n250:             )\n251:         pytest.fail(f\"{' '.join(spec.live_smoke)} hung for 120s with no result:\\n{out[-1500:]}\")\n252:     out = proc.stdout + proc.stderr\n253:     assert proc.returncode == 0, f\"{' '.join(spec.live_smoke)} exited {proc.returncode}:\\n{out[-1500:]}\"\n254:     assert spec.live_expect in out, f\"expected {spec.live_expect!r} in output:\\n{out[-1500:]}\"\n255: \n256: \n257: _AUTH_MARKERS = (\"Waiting for authorization\", \"Only continue with a code you requested\", \"Please log in\", \"not logged in\")\n258: \n259: \n260: def _looks_like_auth_prompt(text: str) -> bool:\n261:     return any(m in text for m in _AUTH_MARKERS)\n\n(End of file - total 261 lines)\n</content>","metadata":{"preview":"\"\"\"Validate the agent CLI flags our skills depend on against the installed CLIs.\n\nThree layers, all driven by ``agent-cli-contract.toml``:\n\n1. **Help contract** — ``<cmd> --help`` of the installed ``claude``, ``codex``,\n   ``grok`` and ``herdr`` must advertise every flag and enum value the\n   contract lists. Fast, no auth, no tokens. This is the drift detector: a\n   CLI release that renames ``--dangerously-skip-permissions`` fails here.\n2. **Source contract** — every agent invocation in the skill sources uses only\n   contracted flags, and every contracted flag is used somewhere. This keeps\n   the contract and the skills from drifting apart in either direction.\n3. **Live smoke** (opt-in, ``AGENT_CLI_LIVE=1``) — runs the canonical headless\n   unattended invocation for each agent and expects a PONG. Bills tokens.\n\nRun:  uv run pytest src/planning-workflow/tests/\n      AGENT_CLI_LIVE=1 uv run pytest src/planning-workflow/tests/ -k live\n\"\"\"\n\nfrom __future__ import annotations\n","truncated":false,"loaded":[]},"title":"src/planning-workflow/tests/test_agent_cli_contract.py","time":{"start":1789032468786,"end":1789032468803}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the test file to understand the full picture of what's already there.","format":"unknown","index":0}]}},"id":"prt_08aa51052001ZFm1c69G0IJygd","sessionID":"ses_f755b0823ffeqOHS10F8XEOvrV","messageID":"msg_08aa50bde00204hKMzOAJGMS0p"}}
