", \"--timeout\"]\n122: [agent.herdr.command.values]\n123: \"--kind\" = [\"claude\", \"codex\"]\n124: \n125: [[agent.herdr.command]]\n126: path = \"agent prompt\"\n127: flags = [\"--wait\", \"--timeout\"]\n128: \n129: [[agent.herdr.command]]\n130: path = \"agent wait\"\n131: flags = [\"--until\", \"--timeout\"]\n132: [agent.herdr.command.values]\n133: \"--until\" = [\"idle\", \"working\", \"blocked\", \"done\"]\n134: \n135: [[agent.herdr.command]]\n136: path = \"agent read\"\n137: flags = [\"--source\", \"--lines\", \"--format\"]\n138: [agent.herdr.command.values]\n139: \"--source\" = [\"visible\", \"recent\", \"recent-unwrapped\", \"detection\"]\n140: \"--format\" = [\"text\", \"ansi\"]\n141: \n142: [[agent.herdr.command]]\n143: path = \"agent rename\"\n144: flags = [\"--clear\"]\n145: \n146: [[agent.herdr.command]]\n147: path = \"pane process-info\"\n148: flags = [\"--pane\"]\n149: \n150: [[agent.herdr.command]]\n151: path = \"pane read\"\n152: flags = [\"--source\", \"--lines\", \"--format\"]\n153: [agent.herdr.command.values]\n154: \"--source\" = [\"visible\", \"recent\", \"recent-unwrapped\"]\n155: \"--format\" = [\"text\", \"ansi\"]\n156: \n157: [[agent.herdr.command]]\n158: path = \"pane wait-output\"\n159: flags = [\"--match\", \"--regex\", \"--source\", \"--lines\", \"--timeout\"]\n160: [agent.herdr.command.values]\n161: \"--source\" = [\"visible\", \"recent\", \"recent-unwrapped\"]\n162: \n163: [[agent.herdr.command]]\n164: path = \"pane split\"\n165: flags = [\"--current\", \"--direction\", \"--cwd\", \"--no-focus\"]\n166: [agent.herdr.command.values]\n167: \"--direction\" = [\"right\", \"down\"]\n168: \n169: [[agent.herdr.command]]\n170: path = \"pane list\"\n171: flags = [\"--workspace\"]\n172: \n173: [[agent.herdr.command]]\n174: path = \"pane rename\"\n175: flags = [\"--clear\"]\n176: \n177: [[agent.herdr.command]]\n178: path = \"tab create\"\n179: flags = [\"--workspace\", \"--cwd\", \"--label\", \"--no-focus\"]\n180: \n181: [[agent.herdr.command]]\n182: path = \"tab list\"\n183: flags = [\"--workspace\"]\n184: \n185: [[agent.herdr.command]]\n186: path = \"workspace create\"\n187: flags = [\"--cwd\", \"--label\", \"--env\", \"--no-focus\"]\n188: \n189: [[agent.herdr.command]]\n190: path = \"worktree create\"\n191: flags = [\"--cwd\", \"--branch\", \"--base\", \"--label\", \"--no-focus\"]\n192: \n193: [[agent.herdr.command]]\n194: path = \"worktree list\"\n195: flags = [\"--cwd\", \"--workspace\"]\n196: \n197: [[agent.herdr.command]]\n198: path = \"worktree remove\"\n199: flags = [\"--workspace\", \"--force\"]\n\n(End of file - total 199 lines)\n</content>\n\n<system-reminder>\nInstructions from: /home/vscode/src/skills/src/CLAUDE.md\n# `src`\n\nThis folder contains compilable skills. This is useful because sometimes multiple skills want to share the same docs and references.\n\nInstead of having drift when updates happen, we have a simple framework for compiling our skills via a python DSL.\n\n## Directory structure\n\n```\nsrc/\n  planning-workflow/              # module — a group of related skills\n    refs/\n      communicate-during-plan-reviews.md\n    skills/\n      review-task/\n        SKILL.md                  # supports {{ ref:filename }} templating\n      resolve-comments/\n        SKILL.md\n  compile.py                      # DSL + compiler\n```\n\nOutput goes to `./skills/` at the repo root:\n\n```\nskills/\n  review-task/\n    SKILL.md\n    references/\n      communicate-during-plan-reviews.md\n  resolve-comments/\n    SKILL.md\n    references/\n      communicate-during-plan-reviews.md\n```\n\n## Module conventions\n\n- Each module is a directory under `src/` (excluding `compile.py` and `CLAUDE.md`).\n- `refs/` contains shared reference files available to all skills in the module.\n- `skills/<name>/SKILL.md` is the template for each skill. It must have YAML frontmatter with `name` and `description`.\n- Skills can include additional files beyond SKILL.md (e.g. their own local references not shared with other skills).\n\n## Templating\n\nSKILL.md files support two directives:\n\n- `{{ ref:<filename> }}` — replaced with the full contents of `refs/<filename>` from the same module. The referenced file is also copied to `references/<filename>` in the compiled output. Must appear on its own line (line-anchored).\n\n- `{{ skill:<name> }}` — replaced with the compiled skill name. Appears inline (not line-anchored) — typically used mid-sentence, e.g. `run /{{ skill:new-solution }}`. Works in both SKILL.md templates and ref files.\n\n  **Resolution rules:**\n  - Bare name (e.g. `{{ skill:new-solution }}`) — resolves if the skill exists in exactly one module. If the name exists in multiple modules, the compiler errors and requires the qualified form.\n  - Qualified name (e.g. `{{ skill:rich-docs/rich-doc }}`) — resolves in the named module. Errors if the module or skill is not found.\n\n  **Validation:** The compiler validates all `{{ skill:X }}` references in Phase 1 (before writing any output). Unknown skills, unknown modules, and ambiguous bare names all produce errors.\n\n- `{{ pd-version }}` — replaced with the current pd-components release tag (e.g. `pd-v0.4.0`), read from `pd-components/package.json` at compile time. Appears inline. Works in both SKILL.md templates and ref files.\n\n- `{{ index:techniques }}` — replaced with a generated markdown table of all technique cards declared for the skill. Columns: Technique, What it catches, Oracle, Archetypes, Crit, Volatility, Link. The table is built from each `technique-*.md` card's frontmatter at compile time.\n\nTechnique cards follow the `technique-<slug>.md` naming convention and live in the module's `refs/` directory. Each card has flat frontmatter with 13 required keys (`name`, `summary`, `oracle`, `archetypes`, `criticality-min`, `volatility-fit`, `harness`, `pairs-with`, `upgrade-looser`, `upgrade-stricter`, `cost-author`, `cost-maintain`, `cost-run`) and 12 exact-title `## ` sections validated at compile time. Missing keys, missing sections, or out-of-order sections fail the build.\n\n## DSL (compile.py)\n\nThe DSL declares modules, their skills, and which refs each skill uses. Example:\n\n```python\nfrom compiler import module, skill, ref\n\nplanning_workflow = module(\"planning-workflow\",\n    skill(\"review-task\", refs=[ref(\"communicate-during-plan-reviews.md\")]),\n    skill(\"resolve-comments\", refs=[ref(\"communicate-during-plan-reviews.md\")]),\n)\n\ncompile([planning_workflow])\n```\n\nThe `compile()` function:\n1. Validates that all referenced files exist (refs, skill templates)\n2. Validates that every `{{ ref:X }}` in a SKILL.md has a matching ref declaration\n3. Warns if a declared ref is unused by the skill template\n4. Checks that the final rendered SKILL.md is under a size limit (default 15,000 chars) to avoid bloated skill files\n5. Renders templates and copies refs to `./skills/<name>/`\n\n## Install script generation\n\nThe compiler also generates `install.sh` at the repo root. This script lets downstream consumers install all skills or a specific module:\n\n```bash\n./install.sh                              # all skills\n./install.sh --module planning-workflow   # just planning skills\n./install.sh --target claude              # .claude/skills only\n```\n\nIt is a thin wrapper over `auto skill add`, which is the tool of record for\ninstalling skills. The module→skill mappings are baked into the case block at\ncompile time, so the script is always in sync with the DSL declarations. The\nrepo slug is set via the `REPO` constant in `compile.py`.\n\nTwo things about `auto` shape the script:\n\n- **Targets are project config, not per-command flags.** `auto skill add` has no\n  `--agent` equivalent; output targets come from `.auto/skills/skills.yaml`. So\n  the script runs `auto skill init --project --target \"$TARGETS\"` when that file\n  is missing, and `--target` sets the styles (`claude`, `agents`) rather than\n  agent names.\n- **Remote sources prompt for trust.** In a non-interactive shell there is\n  nobody to answer, so the script passes `--trust-requested` when stdin is not a\n  TTY.\n\n## Claude Code plugin + marketplace generation\n\nThe compiler also packages the repo as a [Claude Code plugin marketplace](https://code.claude.com/docs/en/plugins-reference), so users can install skills via `/plugin` without the `auto skill` flow. Each **module maps to one plugin**; the repo root is the marketplace.\n\nIt emits (all regenerated from scratch each compile, so they never drift from the DSL):\n\n- `.claude-plugin/marketplace.json` — lists every module as a plugin entry (`name`, `source`, `description`, `category`).\n- `plugins/<module>/.claude-plugin/plugin.json` — the plugin manifest (`name`, `description`, `author`, `keywords`, …).\n- `plugins/<module>/skills/<skill>/` — a **copy** of each compiled skill (`SKILL.md` + `references/`).\n\nModule metadata for the manifests comes from the DSL: `module()` accepts `description`, `category`, `keywords`, and `display_name` keyword args. Marketplace-level constants (`MARKETPLACE_NAME`, `OWNER`, etc.) live near `_generate_plugins` in `compile.py`.\n\n**Versioning:** the `version` field is intentionally omitted, so Claude Code versions each plugin by git commit SHA — consumers pick up changes on every commit with no manual bump. (`claude plugin validate --strict` will warn about the missing version; this is expected.)\n\nInstall flow for consumers:\n\n```bash\n/plugin marketplace add mistakenot/skills\n/plugin install planning-workflow@mistakenot-skills\n```\n\nSkills installed this way are namespaced as `<module>:<skill>` (e.g. `planning-workflow:new-task`).\n\n## Pre-compile checks\n\n- All ref files referenced in the DSL exist in the module's `refs/` directory\n- All skill template files exist in the module's `skills/<name>/` directory\n- Every `{{ ref:X }}` tag in a template has a corresponding ref in the DSL declaration\n- Every ref in the DSL declaration is actually used by a `{{ ref:X }}` tag in the template (warn, don't fail)\n- Every `{{ skill:X }}` tag in templates and ref files resolves to a known skill (error on unknown or ambiguous)\n- YAML frontmatter in each SKILL.md contains required fields: `name`, `description`\n- Final rendered output is under the size limit\n\n</system-reminder>","metadata":{"preview":"# Agent CLI contract — every flag our skills and harnesses pass to an agent CLI.\n#\n# Checked by test_agent_cli_contract.py against the *installed* CLIs:\n#   1. `<cmd> --help` must advertise every flag (and enum value) listed here.\n#   2. Every agent invocation in the skill sources may only use flags listed here.\n#   3. Every flag listed here must be used by at least one skill source\n#      (keeps this file an honest picture of the dependency surface).\n#\n# When a CLI release renames or drops a flag, test 1 fails; fix the skill refs\n# AND this file. When a skill starts using a new flag, test 2 fails; add the\n# flag here and confirm test 1 passes against the installed release.\n#\n# `verified_version` is the newest release these flags were confirmed against.\n# Bump it after a green run on a newer install; the version test fails if the\n# installed CLI is *older* than this (an old install proves nothing).\n\n# ---------------------------------------------------------------------------\n[agent.claude]\nverified_version = \"2.1.263\"\n# Headless unattended run — opt-in via AGENT_CLI_LIVE=1, bills tokens.","truncated":false,"loaded":["/home/vscode/src/skills/src/CLAUDE.md"]},"title":"src/planning-workflow/tests/agent-cli-contract.toml","time":{"start":1789032467161,"end":1789032467202}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_08aa50a5f001CgwWJMqZqhsdTn","sessionID":"ses_f755b0823ffeqOHS10F8XEOvrV","messageID":"msg_08aa50662002xFdNHHhDM7Q2j4"}}
{"type":"tool_use","timestamp":1789032467308,"sessionID":"ses_f755b0823ffeqOHS10F8XEOvrV","part":{"type":"tool","tool":"read","callID":"call_dacd1fbd646c4071a210364a","state":{"status":"completed","input":{"filePath":"/home/vscode/src/skills/src/planning-workflow/tests/agent_cli_contract.py"},"output":"<path>/home/vscode/src/skills/src/planning-workflow/tests/agent_cli_contract.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Agent CLI contract — the flags our skills depend on, checked against reality.\n2: \n3: The skills under ``src/planning-workflow`` (and the eval harnesses) drive\n4: ``claude``, ``codex``, ``grok`` and ``herdr`` from bash with hardcoded flags:\n5: permission bypasses, sandbox modes, headless/print mode, pane and worktree\n6: control. Those CLIs change fast, and when a flag is renamed or removed the\n7: skill keeps \"working\" right up until a background worker stalls on a\n8: permission prompt nobody can answer.\n9: \n10: This module is the machinery behind ``test_agent_cli_contract.py``:\n11: \n12: * ``load_contract``   — reads ``agent-cli-contract.toml`` (the flags we rely on).\n13: * ``parse_help``      — turns ``<cmd> --help`` output into a flag/values table.\n14: * ``scan_sources``    — finds every ``claude|codex|grok|herdr ...`` invocation in\n15:                         the skill sources and extracts the flags it uses.\n16: \n17: Run ``python agent_cli_contract.py`` to print the inventory of invocations the\n18: scanner finds — useful when adding a new flag to the contract.\n19: \"\"\"\n20: \n21: from __future__ import annotations\n22: \n23: import os\n24: import re\n25: import shlex\n26: import subprocess\n27: import sys\n28: import tomllib\n29: from dataclasses import dataclass, field\n30: from pathlib import Path\n31: \n32: HERE = Path(__file__).resolve().parent\n33: REPO_ROOT = HERE.parents[2]\n34: SRC_ROOT = REPO_ROOT / \"src\"\n35: CONTRACT_PATH = HERE / \"agent-cli-contract.toml\"\n36: \n37: AGENTS = (\"claude\", \"codex\", \"gemini\", \"opencode\", \"grok\", \"herdr\")\n38: \n39: # --- contract ---------------------------------------------------------------\n40: \n41: \n42: @dataclass(frozen=True)\n43: class Command:\n44:     \"\"\"One command path in the contract, e.g. ``codex exec`` or ``herdr agent start``.\"\"\"\n45: \n46:     agent: str\n47:     path: tuple[str, ...]  # subcommand words after the agent name\n48:     flags: frozenset[str]\n49:     values: dict[str, tuple[str, ...]]  # flag -> enum values that must exist\n50: \n51:     @property\n52:     def argv(self) -> list[str]:\n53:         return [self.agent, *self.path]\n54: \n55:     @property\n56:     def key(self) -> str:\n57:         return \" \".join(self.argv)\n58: \n59: \n60: @dataclass(frozen=True)\n61: class Agent:\n62:     name: str\n63:     verified_version: str\n64:     live_smoke: list[str] | None\n65:     live_expect: str | None\n66:     commands: dict[str, Command]  # keyed by Command.key\n67: \n68: \n69: @dataclass(frozen=True)\n70: class Contract:\n71:     agents: dict[str, Agent]\n72: \n73:     def command(self, agent: str, path: tuple[str, ...]) -> Command | None:\n74:         return self.agents[agent].commands.get(\" \".join((agent, *path)))\n75: \n76:     def all_commands(self) -> list[Command]:\n77:         return [c for a in self.agents.values() for c in a.commands.values()]\n78: \n79: \n80: def load_contract(path: Path = CONTRACT_PATH) -> Contract:\n81:     raw = tomllib.loads(path.read_text())\n82:     agents: dict[str, Agent] = {}\n83:     for name, spec in raw[\"agent\"].items():\n84:         commands: dict[str, Command] = {}\n85:         for entry in spec.get(\"command\", []):\n86:             path_words = tuple(entry.get(\"path\", \"\").split())\n87:             cmd = Command(\n88:                 agent=name,\n89:                 path=path_words,\n90:                 flags=frozenset(entry.get(\"flags\", [])),\n91:                 values={k: tuple(v) for k, v in entry.get(\"values\", {}).items()},\n92:             )\n93:             commands[cmd.key] = cmd\n94:         agents[name] = Agent(\n95:             name=name,\n96:             verified_version=spec[\"verified_version\"],\n97:             live_smoke=spec.get(\"live_smoke\"),\n98:             live_expect=spec.get(\"live_expect\"),\n99:             commands=commands,\n100:         )\n101:     return Contract(agents=agents)\n102: \n103: \n104: # --- help parsing -----------------------------------------------------------\n105: \n106: _OPTION_LINE = re.compile(r\"^\\s{2,}(-{1,2}[A-Za-z])\")\n107: _FLAG_TOKEN = re.compile(r\"(?<![\\w-])(-{1,2}[A-Za-z][\\w-]*)\")\n108: _CLAP_VALUES = re.compile(r\"\\[possible values:\\s*([^\\]]+)\\]\")\n109: _COMMANDER_CHOICES = re.compile(r\"\\(choices:\\s*([^)]+)\\)\")\n110: _YARGS_CHOICES = re.compile(r\"\\[choices:\\s*([^\\]]+)\\]\")\n111: _QUOTED = re.compile(r'\"([^\"]+)\"')\n112: \n113: \n114: @dataclass\n115: class HelpSurface:\n116:     \"\"\"Flags and enum values advertised by one ``<cmd> --help``.\"\"\"\n117: \n118:     argv: list[str]\n119:     text: str\n120:     flags: set[str] = field(default_factory=set)\n121:     values: dict[str, set[str]] = field(default_factory=dict)\n122: \n123: \n124: def parse_help(argv: list[str], text: str) -> HelpSurface:\n125:     \"\"\"Parse commander (claude) and clap (codex/grok/herdr) style help output.\n126: \n127:     An option line is an indented line starting with ``-x`` or ``--long``. The\n128:     option group is the text before the first run of two+ spaces (or the\n129:     description on the next line); every ``-x``/``--long`` token in it is a\n130:     flag. Enum values are read from the block of lines that follows the option\n131:     line, in either clap's ``[possible values: a, b]`` or commander's\n132:     ``(choices: \"a\", \"b\")`` form.\n133:     \"\"\"\n134:     surface = HelpSurface(argv=argv, text=text)\n135:     lines = text.splitlines()\n136:     i = 0\n137:     while i < len(lines):\n138:         line = lines[i]\n139:         if not _OPTION_LINE.match(line):\n140:             i += 1\n141:             continue\n142:         group = re.split(r\"\\s{2,}\", line.strip(), maxsplit=1)[0]\n143:         # Commander puts `<placeholder>` in the group; drop it before tokenising.\n144:         group = re.sub(r\"<[^>]*>\", \" \", group)\n145:         flags = _FLAG_TOKEN.findall(group)\n146:         # Collect the block up to the next option line for enum values.\n147:         block = [line]\n148:         j = i + 1\n149:         while j < len(lines) and not _OPTION_LINE.match(lines[j]):\n150:             block.append(lines[j])\n151:             j += 1\n152:         block_text = \"\\n\".join(block)\n153:         vals: set[str] = set()\n154:         for m in _CLAP_VALUES.finditer(block_text):\n155:             vals |= {v.strip() for v in m.group(1).split(\",\") if v.strip()}\n156:         for m in _COMMANDER_CHOICES.finditer(block_text):\n157:             vals |= set(_QUOTED.findall(m.group(1)))\n158:         for m in _YARGS_CHOICES.finditer(block_text):\n159:             vals |= set(_QUOTED.findall(m.group(1)))\n160:         for f in flags:\n161:             surface.flags.add(f)\n162:             if vals:\n163:                 surface.values.setdefault(f, set()).update(vals)\n164:         i = j\n165:     return surface\n166: \n167: \n168: def run_help(argv: list[str], timeout: int = 30) -> tuple[int, str]:\n169:     \"\"\"Run ``<argv> --help`` with stdin closed; returns (rc, combined output).\"\"\"\n170:     proc = subprocess.run(\n171:         [*argv, \"--help\"],\n172:         stdin=subprocess.DEVNULL,\n173:         capture_output=True,\n174:         text=True,\n175:         timeout=timeout,\n176:         env={**os.environ, \"NO_COLOR\": \"1\", \"TERM\": \"dumb\"},\n177:     )\n178:     return proc.returncode, proc.stdout + proc.stderr\n179: \n180: \n181: _VERSION = re.compile(r\"(\\d+(?:\\.\\d+)+)\")\n182: \n183: \n184: def installed_version(agent: str, timeout: int = 30) -> str | None:\n185:     proc = subprocess.run(\n186:         [agent, \"--version\"],\n187:         stdin=subprocess.DEVNULL,\n188:         capture_output=True,\n189:         text=True,\n190:         timeout=timeout,\n191:     )\n192:     m = _VERSION.search(proc.stdout + proc.stderr)\n193:     return m.group(1) if m else None\n194: \n195: \n196: def version_tuple(v: str) -> tuple[int, ...]:\n197:     return tuple(int(p) for p in v.split(\".\"))\n198: \n199: \n200: # --- source scanning --------------------------------------------------------\n201: \n202: # An agent name at a command position: not glued to a path (`/bin/claude`), a\n203: # hyphenated name (`w-claude`), a variable (`$claude`) or another word.\n204: _CMD_START = re.compile(r\"(?<![\\w/.$,-])(?<!--kind )(?<!--member )(?<!--members )(claude|codex|gemini|opencode|grok|herdr)\\b(?![\\w/.,-])\")\n205: _SUBCOMMAND = re.compile(r\"^[a-z][a-z-]*$\")\n206: _FLAG = re.compile(r\"^-{1,2}[A-Za-z][\\w-]*\")\n207: # Shell filters that commonly follow a `|` — stop scanning there so `jq -r`\n208: # flags aren't attributed to the agent.\n209: _PIPE_FILTERS = {\"jq\", \"grep\", \"rg\", \"tee\", \"head\", \"tail\", \"awk\", \"sed\", \"xargs\", \"sort\", \"wc\", \"cut\", \"tr\"}\n210: # Max depth of subcommand words we attribute to a command path.\n211: _MAX_PATH = {\"claude\": 2, \"codex\": 2, \"gemini\": 1, \"opencode\": 1, \"grok\": 1, \"herdr\": 2}\n212: \n213: SCAN_SUFFIXES = {\".md\", \".sh\", \".py\", \".toml\", \".yaml\", \".yml\"}\n214: SCAN_EXCLUDE_DIRS = {\"__pycache__\", \".venv\", \"node_modules\", \"runs\", \"cache\"}\n215: \n216: \n217: @dataclass(frozen=True)\n218: class Invocation:\n219:     agent: str\n220:     path: tuple[str, ...]\n221:     flags: tuple[str, ...]\n222:     file: Path\n223:     line: int\n224:     text: str\n225: \n226:     @property\n227:     def key(self) -> str:\n228:         return \" \".join((self.agent, *self.path))\n229: \n230: \n231: def _join_continuations(text: str) -> list[tuple[int, str]]:\n232:     \"\"\"Join backslash-continued lines; yields (first_line_no, joined_text).\"\"\"\n233:     out: list[tuple[int, str]] = []\n234:     buf: list[str] = []\n235:     start = 0\n236:     for n, line in enumerate(text.splitlines(), start=1):\n237:         stripped = line.rstrip()\n238:         if not buf:\n239:             start = n\n240:         if stripped.endswith(\"\\\\\"):\n241:             buf.append(stripped[:-1])\n242:             continue\n243:         buf.append(stripped)\n244:         out.append((start, \" \".join(buf)))\n245:         buf = []\n246:     if buf:\n247:         out.append((start, \" \".join(buf)))\n248:     return out\n249: \n250: \n251: def _tokenize(s: str) -> list[str]:\n252:     try:\n253:         return shlex.split(s, posix=True)\n254:     except ValueError:\n255:         return s.split()\n256: \n257: \n258: def _clean(tok: str) -> str:\n259:     return tok.strip(\"[]()<>`'\\\",;\")\n260: \n261: \n262: def parse_invocation(text: str, file: Path, line: int) -> list[Invocation]:\n263:     \"\"\"Extract agent invocations (possibly nested after ``--``) from one line.\"\"\"\n264:     if text.lstrip().startswith(\"#\"):\n265:         return []\n266:     m = _CMD_START.search(text)\n267:     if not m:\n268:         return []\n269:     # Cut trailing markdown/backtick and a comment.\n270:     rest = text[m.end():]\n271:     rest = rest.split(\"`\", 1)[0]\n272:     rest = re.split(r\"\\s#\", rest, maxsplit=1)[0]\n273:     tokens = _tokenize(rest)\n274:     return _parse_tokens(m.group(1), tokens, file, line, text)\n275: \n276: \n277: def _parse_tokens(agent: str, tokens: list[str], file: Path, line: int, text: str) -> list[Invocation]:\n278:     path: list[str] = []\n279:     flags: list[str] = []\n280:     results: list[Invocation] = []\n281:     kind: str | None = None  # herdr `agent start --kind X` names the nested agent\n282:     # `<name>|--clear` style alternations in usage lines: split into parts.\n283:     tokens = [part for tok in tokens for part in (tok.split(\"|\") if \"|\" in tok and tok != \"|\" else [tok])]\n284:     i = 0\n285:     while i < len(tokens):\n286:         tok = tokens[i]\n287:         if tok in (\"|\", \"&&\", \"||\", \";\"):\n288:             # Stop at a pipe into a shell filter, or at any command separator.\n289:             if tok == \"|\" and i + 1 < len(tokens) and tokens[i + 1] not in _PIPE_FILTERS:\n290:                 i += 1\n291:                 continue\n292:             break\n293:         if tok == \"--\":\n294:             # Everything after `--` is the nested agent's argv. `herdr agent\n295:             # start --kind X -- <args>` launches X itself, so the args omit the\n296:             # executable; otherwise the first nested token names the agent.\n297:             nested = tokens[i + 1:]\n298:             if nested and nested[0] in AGENTS:\n299:                 results.extend(_parse_tokens(nested[0], nested[1:], file, line, text))\n300:             elif kind in AGENTS:\n301:                 results.extend(_parse_tokens(kind, nested, file, line, text))\n302:             break\n303:         clean = _clean(tok)\n304:         if _FLAG.match(clean):\n305:             name = clean.split(\"=\", 1)[0]\n306:             flags.append(name)\n307:             if name == \"--kind\" and i + 1 < len(tokens):\n308:                 kind = _clean(tokens[i + 1])\n309:         elif not flags and len(path) < _MAX_PATH[agent] and _SUBCOMMAND.match(clean):\n310:             path.append(clean)\n311:         i += 1\n312:     results.insert(0, Invocation(agent, tuple(path), tuple(flags), file, line, text.strip()))\n313:     return results\n314: \n315: \n316: def iter_source_files(roots: list[Path]) -> list[Path]:\n317:     files: list[Path] = []\n318:     for root in roots:\n319:         if root.is_file():\n320:             files.append(root)\n321:             continue\n322:         for dirpath, dirnames, filenames in os.walk(root):\n323:             dirnames[:] = [d for d in dirnames if d not in SCAN_EXCLUDE_DIRS]\n324:             for fn in filenames:\n325:                 p = Path(dirpath) / fn\n326:                 if p.suffix not in SCAN_SUFFIXES or p.resolve() == Path(__file__).resolve():\n327:                     continue\n328:                 if fn.startswith(\"test_\") and p.suffix == \".py\":\n329:                     continue  # pytest modules quote argv fragments as data, not invocations\n330:                 files.append(p)\n331:     return sorted(files)\n332: \n333: \n334: def scan_sources(roots: list[Path]) -> list[Invocation]:\n335:     found: list[Invocation] = []\n336:     for f in iter_source_files(roots):\n337:         try:\n338:             text = f.read_text(encoding=\"utf-8\")\n339:         except UnicodeDecodeError:\n340:             continue\n341:         for line_no, joined in _join_continuations(text):\n342:             found.extend(parse_invocation(joined, f, line_no))\n343:     return found\n344: \n345: \n346: # Sources whose agent invocations the contract must cover. Keep this list in\n347: # step with where skills and harnesses shell out to an agent.\n348: DEFAULT_SCAN_ROOTS = [\n349:     SRC_ROOT / \"planning-workflow\",\n350:     SRC_ROOT / \"consult-the-council\",\n351:     SRC_ROOT / \"assurance\" / \"evals\" / \"run.sh\",\n352: ]\n353: \n354: \n355: def main(argv: list[str]) -> int:\n356:     roots = [Path(a) for a in argv[1:]] or DEFAULT_SCAN_ROOTS\n357:     by_cmd: dict[str, dict[str, list[Invocation]]] = {}\n358:     for inv in scan_sources(roots):\n359:         if not inv.flags:\n360:             continue\n361:         for fl in inv.flags:\n362:             by_cmd.setdefault(inv.key, {}).setdefault(fl, []).append(inv)\n363:     for key in sorted(by_cmd):\n364:         print(f\"== {key}\")\n365:         for fl in sorted(by_cmd[key]):\n366:             locs = by_cmd[key][fl]\n367:             where = \", \".join(f\"{i.file.relative_to(REPO_ROOT)}:{i.line}\" for i in locs[:3])\n368:             more = f\" (+{len(locs) - 3})\" if len(locs) > 3 else \"\"\n369:             print(f\"   {fl:<45} {where}{more}\")\n370:     return 0\n371: \n372: \n373: if __name__ == \"__main__\":\n374:     sys.exit(main(sys.argv))\n\n(End of file - total 374 lines)\n</content>","metadata":{"preview":"\"\"\"Agent CLI contract — the flags our skills depend on, checked against reality.\n\nThe skills under ``src/planning-workflow`` (and the eval harnesses) drive\n``claude``, ``codex``, ``grok`` and ``herdr`` from bash with hardcoded flags:\npermission bypasses, sandbox modes, headless/print mode, pane and worktree\ncontrol. Those CLIs change fast, and when a flag is renamed or removed the\nskill keeps \"working\" right up until a background worker stalls on a\npermission prompt nobody can answer.\n\nThis module is the machinery behind ``test_agent_cli_contract.py``:\n\n* ``load_contract``   — reads ``agent-cli-contract.toml`` (the flags we rely on).\n* ``parse_help``      — turns ``<cmd> --help`` output into a flag/values table.\n* ``scan_sources``    — finds every ``claude|codex|grok|herdr ...`` invocation in\n                        the skill sources and extracts the flags it uses.\n\nRun ``python agent_cli_contract.py`` to print the inventory of invocations the\nscanner finds — useful when adding a new flag to the contract.\n\"\"\"\n","truncated":false,"loaded":[]},"title":"src/planning-workflow/tests/agent_cli_contract.py","time":{"start":1789032467261,"end":1789032467305}},"id":"prt_08aa50b220011Mn5zgFgJxJb94","sessionID":"ses_f755b0823ffeqOHS10F8XEOvrV","messageID":"msg_08aa50662002xFdNHHhDM7Q2j4"}}
